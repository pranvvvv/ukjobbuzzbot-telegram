# JobPilot configuration. Copy to .env and fill in. Never commit .env.
# Run `uv run python -m jobpilot doctor` after editing to check everything.

# --- Required -----------------------------------------------------------
# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (message @userinfobot to get it). Comma-separate several.
ALLOWED_USER_IDS=

# AI provider: anthropic | gemini | openai | groq | fake
#   anthropic → Claude (default model claude-haiku-5-5, ~$0.003 per full search)
#   fake      → no AI: rule-based resume parsing + "basic match" scoring (works offline)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional model override, e.g. claude-sonnet-5-5 for higher-quality scoring.
LLM_MODEL=

# --- Optional job sources (more jobs; free keys) ---------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=

# --- Matching & cost guard (defaults are fine) ----------------------------
MATCH_THRESHOLD=60
BASIC_MATCH_THRESHOLD=40
MAX_JOB_AGE_DAYS=14
LLM_DAILY_BUDGET_USD=0.25
LLM_MAX_TOKENS_PER_RUN=150000
ADZUNA_DAILY_LIMIT=200
ADZUNA_MONTHLY_LIMIT=2000
JSEARCH_MONTHLY_LIMIT=100
ENABLE_REMOTE_BOARDS=true
# Local embeddings (one-time ~70 MB download); false = lightweight lexical similarity.
USE_LOCAL_EMBEDDINGS=true
# Path to your own companies.yaml (default: the bundled jobpilot/data/companies.yaml).
COMPANIES_FILE=

# --- Optional -----------------------------------------------------------
# Where the database, logs and caches live. Default: %LOCALAPPDATA%\JobPilot (Windows),
# ~/.local/share/JobPilot (Linux), ~/Library/Application Support/JobPilot (macOS).
# Keep this OUTSIDE OneDrive/Dropbox: syncing a live SQLite database can corrupt it.
DATA_DIR=
# Default: sqlite+aiosqlite:///<DATA_DIR>/jobpilot.db
DATABASE_URL=
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_DIGEST_TIME=09:00
DEFAULT_JOBS_PER_DIGEST=10
LOG_LEVEL=INFO
